#!/usr/bin/make -f
# See debian/control for build dependencies

# Force the standard debhelper sequencer
%:
	dh $@ --buildsystem=cmake

# Pass custom options to the CMake configuration phase if needed
override_dh_auto_configure:
	dh_auto_configure -- \
		-DWANT_DEBUG=OFF \
		-DENABLE_ASAN=OFF \
		-DWANT_TRAVERSO_DEBUG=OFF

# Optional: strip rpath from binaries during installation if required by policy
override_dh_strip:
	dh_strip --no-automatic-dbgsym
